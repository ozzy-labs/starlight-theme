{
  "name": "@ozzy-labs/docs-theme",
  "version": "0.0.1",
  "description": "Shared Starlight docs theme for OzzyLabs product repositories",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/components",
    "src/styles",
    "assets"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsup --dts-only",
    "dev": "tsup --watch"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.2",
    "astro": "^6.1.0",
    "rehype-mermaid": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
