{
  "name": "@ozzy-labs/docs-theme",
  "version": "0.0.1",
  "description": "Shared Starlight docs theme for OzzyLabs product repositories",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/components",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsup --dts-only",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.38.2",
    "astro": "^6.1.0",
    "rehype-mermaid": "^3.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "4.1.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "dompurify@<3.4.0": "^3.4.0",
      "vite": "^7.3.2"
    }
  }
}
