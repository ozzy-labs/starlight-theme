{
  "name": "@ozzylabs/starlight-theme",
  "version": "0.3.0",
  "description": "Shared Starlight docs theme",
  "type": "module",
  "license": "MIT",
  "author": "ozzy-labs",
  "homepage": "https://github.com/ozzy-labs/starlight-theme#readme",
  "bugs": "https://github.com/ozzy-labs/starlight-theme/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozzy-labs/starlight-theme.git"
  },
  "keywords": [
    "starlight",
    "astro",
    "docs",
    "theme"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": "./src/components/*",
    "./styles/*": "./src/styles/*"
  },
  "files": [
    "dist",
    "src/components",
    "src/styles"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsup --dts-only",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.0",
    "astro": "^7.1.0"
  },
  "dependencies": {
    "rehype-mermaid": "^3.0.0"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.4",
    "astro": "^7.1.3",
    "tsup": "^8.0.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "dompurify@<3.4.0": "^3.4.0",
      "mermaid": "^11.15.0",
      "postcss@^8.0.0": "^8.5.10",
      "uuid@^11.0.0": "^14.0.0",
      "vite": "^8.0.10"
    }
  }
}
